/**
 * secrets.h.example
 *
 * IMPORTANT: Copy this file to secrets.h and fill in your actual credentials.
 * secrets.h is listed in .gitignore and must NEVER be committed to source control.
 *
 * The Wi-Fi credentials that were previously committed to this repository
 * (ssid "KJ iPhone", password "hello123") must be treated as COMPROMISED.
 * Change those credentials before relying on them for any device or network.
 */
#pragma once

// Wi-Fi network credentials
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Device identity – used in API responses and notification events
#define DEVICE_ID     "front-door-camera"

// Notification service (Phase 9) – leave as empty strings until configured
// The notification transport is disabled by default; see NotificationTransport.h
#define NOTIFICATION_ENDPOINT ""
#define NOTIFICATION_TOKEN    ""
